[Unit]
Description=Vault auto-sync watcher (local change + Dropbox longpoll)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=JDAK_WORKSPACE=%h/.openclaw/workspace
EnvironmentFile=-%h/.openclaw/.env
ExecStart=/usr/bin/python3 ${JDAK_WORKSPACE}/bin/vault-sync-watch.py
Restart=always
RestartSec=10
Nice=10

[Install]
WantedBy=default.target
