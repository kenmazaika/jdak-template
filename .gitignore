# Nested git repos / scratch checkouts that must not be added to the vault.
# A clean-room checkout can contain an uninitialized .git directory; git refuses
# to `add -A` it ("does not have a commit checked out").
**/cleanroom/

# Python bytecode caches
__pycache__/
*.pyc

# OS / editor cruft
.DS_Store
.obsidian/workspace*
*.tmp

# Heavy generated data (regenerable; GitHub rejects files >100MB)
*.duckdb
*.duckdb.wal
